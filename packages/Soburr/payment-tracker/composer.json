{
    "name": "soburr/payment-tracker",
    "description": "Self-service payment status tracking for Paystack-powered marketplaces",
    "keywords": ["laravel", "paystack", "payments", "webhooks", "nigeria", "e-commerce"],
    "homepage": "https://github.com/Soburr/selar-paytrace",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Adebesin",
            "email": "your-email@example.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Soburr\\PaymentTracker\\": "src/"
        }
    },
    "extra": {
        "laravel": {
